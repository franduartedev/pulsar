{
  "version": 2,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PULSAR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "sanitize",
      "displayName": "Development with ASAN and UBSAN",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PULSAR_BUILD_TESTS": "ON",
        "PULSAR_ENABLE_ASAN": "ON",
        "PULSAR_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PULSAR_BUILD_TESTS": "ON"
      }
    }
  ]
}
