{
  "version": 2,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PULSAR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "sanitize",
      "displayName": "Development with ASAN and UBSAN",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PULSAR_BUILD_TESTS": "ON",
        "PULSAR_ENABLE_ASAN": "ON",
        "PULSAR_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PULSAR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release-desktop",
      "displayName": "Release desktop build for packaging",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release-desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PULSAR_BUILD_TESTS": "OFF",
        "PULSAR_BUILD_DESKTOP": "ON",
        "PULSAR_BUILD_QT_AUDIO": "ON",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "CMAKE_CXX_FLAGS": "-ffile-prefix-map=${sourceDir}=. -fdebug-prefix-map=${sourceDir}=."
      }
    }
  ]
}
